# Example only. Put real secrets in the hosting provider's secret settings, never in the APK or Git.
PORT=8080
APP_ACCESS_TOKEN=replace-with-a-long-random-token
GEMINI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.5-flash-lite
# Optional alternate chat provider key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Image-provider overrides; image generation needs a separately configured provider and may cost money.
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# Public HTTPS URL of this backend. Render falls back to RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=https://api.example.com
MEDIA_DIR=./media
MEDIA_TTL_SECONDS=86400
MAX_REQUESTS_PER_MINUTE=10
BUILD_GITHUB_REPOSITORY=mhmdfratyff-prog/fraty_ai
BUILD_GITHUB_WORKFLOW=build-generated-android.yml
BUILD_GITHUB_REF=main
BUILD_GITHUB_TOKEN=
BUILD_WORKER_SECRET=
